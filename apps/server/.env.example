# Copy to apps/server/.env for local development. Every value is optional.

# Server port (default 3000)
# PORT=3000

# SQLite database file (default data/psh.db, relative to apps/server)
# DATABASE_PATH=data/psh.db

# Log level: trace|debug|info|warn|error|fatal (default info)
# LOG_LEVEL=info

# MaxMind .mmdb file for IP -> country lookup; leave unset to disable country tracking
# MMDB_PATH=mmdb/GeoLite2-Country.mmdb
